{
  "version": 1,
  "schema_resources": {
    "https://smarthome-ingest/base.schema.json": "schemas/base.schema.json"
  },
  "routes": [
    {
      "id": "firmware-sensor",
      "topic": "smarthome/+/bme680",
      "schema": "schemas/sensor.schema.json",
      "output_schema": "schemas/sensor.output.schema.json",
      "device_id": {
        "pointer": "/device_id",
        "topic_segment": 1
      },
      "sink_target": "sensors",
      "measurement": "bme680",
      "tags": {
        "room": {
          "pointer": "/room"
        },
        "device_class": {
          "pointer": "/device_class"
        }
      },
      "fields": {
        "firmware_version": {
          "pointer": "/fw_version",
          "type": "string"
        },
        "temp_c": {
          "pointer": "/data/temp_c",
          "type": "float"
        },
        "rel_hum_perc": {
          "pointer": "/data/rel_hum_perc",
          "type": "float"
        },
        "pressure_hpa": {
          "pointer": "/data/pressure_hpa",
          "type": "float"
        },
        "gas_ohm": {
          "pointer": "/data/gas_ohm",
          "type": "float"
        },
        "altitude_m": {
          "pointer": "/data/altitude_m",
          "type": "float"
        },
        "time_valid": {
          "pointer": "/time_valid",
          "type": "boolean"
        },
        "time_iso": {
          "pointer": "/time_iso",
          "type": "string"
        },
        "boot_id": {
          "pointer": "/boot_id",
          "type": "unsigned",
          "optional": true
        },
        "seq": {
          "pointer": "/seq",
          "type": "unsigned",
          "optional": true
        },
        "warmed_up": {
          "pointer": "/warmed_up",
          "type": "boolean",
          "optional": true
        },
        "replayed": {
          "pointer": "/replayed",
          "type": "boolean",
          "optional": true
        }
      },
      "timestamp": {
        "source": "payload",
        "pointer": "/time_ms",
        "format": "epoch_ms",
        "valid_flag": "/time_valid",
        "fallback": "received_at"
      },
      "calculations": [
        "dew_point",
        "heat_index",
        "iaq",
        "absolute_humidity",
        "humidity_ratio",
        "surface_temp_at_80rh",
        "dew_point_depression"
      ],
      "cache": true
    },
    {
      "id": "firmware-status",
      "topic": "smarthome/+/status",
