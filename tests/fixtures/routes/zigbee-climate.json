{
  "version": 1,
  "routes": [
    {
      "id": "synthetic-zigbee-climate",
      "topic": "zigbee2mqtt/synthetic_lab_climate",
      "schema": "zigbee-climate.schema.json",
      "device_id": {
        "pointer": "/device_id"
      },
      "measurement": "zigbee_climate",
      "fields": {
        "temp_c": {
          "pointer": "/temperature",
          "type": "float"
        },
        "rel_hum_perc": {
          "pointer": "/humidity",
          "type": "float"
        }
      },
      "timestamp": {
        "source": "received_at"
      },
      "calculations": [
        "dew_point"
      ],
      "cache": true
    }
  ]
}
