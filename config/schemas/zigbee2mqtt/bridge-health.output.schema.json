{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Zigbee2MQTT bridge health record",
  "$comment": "shortcut: Device fields cover two configured IEEE addresses, extend mappings and output properties when adding devices.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "const": "zigbee2mqtt-bridge"
    },
    "measurement": {
      "const": "zigbee2mqtt_bridge_health"
    },
    "timestamp_ms": {
      "$ref": "#/definitions/timestamp"
    },
    "tags": {
      "type": "object",
      "properties": {
        "device_id": {
          "const": "zigbee2mqtt-bridge"
        },
        "device_class": {
          "const": "zigbee2mqtt-bridge"
        }
      },
      "required": [
        "device_id",
        "device_class"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os_load_1m": {
          "$ref": "#/definitions/nonnegative_number"
        },
        "os_load_5m": {
          "$ref": "#/definitions/nonnegative_number"
        },
        "os_load_15m": {
          "$ref": "#/definitions/nonnegative_number"
        },
        "os_memory_used_mib": {
          "$ref": "#/definitions/nonnegative_number"
        },
        "os_memory_perc": {
          "$ref": "#/definitions/percentage"
        },
        "process_uptime_sec": {
          "$ref": "#/definitions/count"
        },
        "process_memory_rss_mib": {
          "$ref": "#/definitions/nonnegative_number"
        },
        "process_memory_perc": {
          "$ref": "#/definitions/percentage"
        },
        "mqtt_connected": {
          "type": "boolean"
        },
        "mqtt_queued": {
          "$ref": "#/definitions/count"
        },
        "mqtt_published": {
          "$ref": "#/definitions/count"
        },
        "mqtt_received": {
          "$ref": "#/definitions/count"
        },
        "device_0x54ef44100171342e_messages": {
          "$ref": "#/definitions/count"
        },
        "device_0x54ef44100171342e_messages_per_sec": {
          "$ref": "#/definitions/nonnegative_number"
        },
        "device_0x54ef44100171342e_leave_count": {
          "$ref": "#/definitions/count"
        },
        "device_0x54ef44100171342e_network_address_changes": {
          "$ref": "#/definitions/count"
        },
        "device_0x00124b0038a8eae2_messages": {
          "$ref": "#/definitions/count"
        },
        "device_0x00124b0038a8eae2_messages_per_sec": {
          "$ref": "#/definitions/nonnegative_number"
        },
        "device_0x00124b0038a8eae2_leave_count": {
          "$ref": "#/definitions/count"
        },
        "device_0x00124b0038a8eae2_network_address_changes": {
          "$ref": "#/definitions/count"
        },
        "mqtt_retained": {
          "type": "boolean"
        }
      },
      "required": [
        "os_load_1m",
        "os_load_5m",
        "os_load_15m",
        "os_memory_used_mib",
        "os_memory_perc",
        "process_uptime_sec",
        "process_memory_rss_mib",
        "process_memory_perc",
        "mqtt_connected",
        "mqtt_queued",
        "mqtt_published",
        "mqtt_received",
        "mqtt_retained"
      ]
    },
    "source_topic": {
      "type": "string",
      "minLength": 1
    },
    "retained": {
      "type": "boolean"
    }
  },
  "required": [
    "route_id",
    "device_id",
    "measurement",
    "timestamp_ms",
    "tags",
    "fields",
    "source_topic",
    "retained"
  ],
  "definitions": {
    "nonnegative_number": {
      "type": "number",
      "minimum": 0
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854
    }
  }
}
