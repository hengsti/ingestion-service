{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["time", "active"],
  "properties": {
    "time": { "type": "integer" },
    "active": { "type": "boolean" },
    "temperature": { "type": "number" },
    "count": { "type": "integer", "minimum": 0 },
    "label": { "type": "string" },
    "code": { "type": "integer" }
  }
}
